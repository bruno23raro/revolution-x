# Revolution X — modelo de variáveis de ambiente
# NÃO colocar valores reais; usar .env.local (preservado) para execução

# PostgreSQL (preencher após criar banco real — Supabase ou Neon)
DATABASE_URL=
DIRECT_URL=

# Banco local (fallback — SQLite para desenvolvimento sem depender do Supabase)
# Quando Supabase retornar, troque DATABASE_URL para a URL do pooler
# DATABASE_URL="file:./dev.db"

# Auth / Supabase (preencher após configurar projeto oficial)
JWT_SECRET=
SESSION_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Email — real transactional delivery (Resend)
# To send real auth e-mails (password reset / email verification) set:
#   EMAIL_PROVIDER=resend
#   EMAIL_API_KEY=re_xxxxxxxxxxxxxxxx   (Resend API key; create at https://resend.com/api-keys)
#   EMAIL_FROM="Revolution X <noreply@yourdomain.com>"  (must be a verified domain/sender in Resend)
# Leave EMAIL_PROVIDER empty to keep the safe local no-op / console fallback.
# Optional: EMAIL_API_BASE_URL overrides the Resend endpoint (default https://api.resend.com).
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_API_BASE_URL=


# Redis / BullMQ
REDIS_URL=

# Armazenamento S3-compatible (preencher após configurar)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Conectores futuros
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# LEGADO (descontinuado): sem consumo no código atual. O WhatsApp opera via
# integração Meta (meta_integrations + Graph API v26.0), não por token manual.
# Mantidas apenas por compatibilidade com deploys antigos — podem ser removidas.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
OPENAI_API_KEY=

# Frontend público (preencher após build oficial)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://revolutionx.com.br  # origin pública — usado nos links de e-mail
META_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Variáveis lidas pelo CÓDIGO que faltavam neste modelo (audit 2026-10)
# ---------------------------------------------------------------------------

# Supabase (nomes que o código efetivamente lê — src/lib/supabase/*)
# NEXT_PUBLIC_* são inline-adas no bundle client no build (comportamento Next.js)
NEXT_PUBLIC_SUPABASE_URL=
# Service role (SOMENTE servidor — nunca expor ao cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Cron — gatilho externo POST /api/cron/tiktok (agendado fora do app)
# Gerar: openssl rand -hex 32  (ou any segredo forte; NUNCA versionar o valor)
CRON_SECRET=

# TikTok OAuth (Content Posting API — app precisa passar pela auditoria da TikTok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# IA — Centro Administrativo (agent center / omni-router)
OMNIROUTER_BASE_URL=
OMNIROUTER_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Docker Compose — Postgres LOCAL (container `db`). Em produção apontar
# DATABASE_URL para o Postgres gerenciado (Supabase/Neon), não para este.
POSTGRES_DB=revolution_x
POSTGRES_USER=revx
POSTGRES_PASSWORD=

# Testes — bancos efêmeros (CI/Docker). TEST_RLS usa role NOSUPERUSER NOBYPASSRLS
# para as asserções de RLS; TEST_ADMIN (BYPASSRLS) só para preparação/limpeza.
TEST_DATABASE_URL=
TEST_ADMIN_DATABASE_URL=
TEST_RLS_DATABASE_URL=
