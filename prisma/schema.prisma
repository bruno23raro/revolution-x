// ============================================================
// WHATSAPP OFICIAL (migration 019) — OpenBSP agora, meta_direct depois.
// ============================================================

model WhatsappChannel {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider         String   @default("openbsp") @db.VarChar(20)
  status           String   @default("PENDING") @db.VarChar(20)
  onboardingTokenId String? @map("onboarding_token_id") @db.Text
  callbackUrl      String?  @map("callback_url") @db.Text
  verifyToken      String   @map("verify_token") @db.Text
  wabaId           String?  @map("waba_id") @db.Text
  phoneNumberId    String?  @map("phone_number_id") @db.Text
  phoneNumber      String?  @map("phone_number") @db.Text
  verifiedName     String?  @map("verified_name") @db.Text
  /// access_token AES-GCM (src/lib/encryption.ts) — nunca expor na UI
  accessTokenEnc   String?  @map("access_token_enc") @db.Text
  tierLimitPer24h  Int      @map("tier_limit_per_24h") @default(250)
  sentWindow24h    Int      @map("sent_window_24h") @default(0)
  windowStartedAt  DateTime? @map("window_started_at") @db.Timestamptz(6)
  lastError        String?  @map("last_error") @db.Text
  createdAt        DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
