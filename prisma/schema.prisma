generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// REVOLUTION X — Prisma Schema (fusão Fonte C + Workspace + Supabase)
//
// Este schema contém:
// - FASE 2: Auth + Multi-tenant
// - FASE 3: CRM (Contact, Lead, Deal, Pipeline)
// - FASE 4: Produtos + Mídia
// - FASE 5: Publicador + Calendário
// - FASE 6: Vídeo
// - FASE 8: Central de Mensagens
// - FASE 9–11: (placeholders)
// - FASE 12: Meta/WhatsApp (waId, externalId, direction)
// - FASE META: MetaIntegration + WebhookEvent (tabela snake_case via @@map)
// ============================================================

// Modelo 1: plano
model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  priceMonthly Decimal  @default(0) @db.Decimal(10, 2)
  limitsJson   Json     @default("{}")
  featuresJson Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  organizations Organization[]
  subscriptions Subscription[]
}

// Modelo 2: usuário
model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(255)
  name             String    @db.VarChar(255)
  passwordHash     String    @db.VarChar(255)
  emailVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt
  organizationMembers OrganizationMember[]
  sessions         Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  // FASE AGENT (Phase 2 — Centro Administrativo com IA)
  tasks        Task[]
  agentMemories AgentMemory[]
}

// Modelo 3: organização (tenant)
model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  slug         String    @unique @db.VarChar(100)
  planId       String?   @db.Uuid
  plan         Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  status       String    @default("active") @db.VarChar(50)
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt
  members      OrganizationMember[]
  roles        Role[]
  subscriptions Subscription[]
  usage        Usage[]
  billingEvents BillingEvent[]
  webhooks       Session[]
  // FASE 12 back-references
  contacts     Contact[]
  leads        Lead[]
  deals        Deal[]
  products     Product[]
  media        Media[]
  posts        Post[]
  calendarEvents CalendarEvent[]
  videos       Video[]
  messages     Message[]
  reports      Report[]
  metaIntegrations MetaIntegration[]
  pipelines    Pipeline[]
  // FASE AGENT (Phase 2 — Centro Administrativo com IA)
  tasks        Task[]
  agentMemories AgentMemory[]
  // FASE 17 — Campanhas e disparos
  campaigns    Campaign[]
}

// Modelo 4: membro de organização
model OrganizationMember {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String        @default("member") @db.VarChar(50)
  joinedAt       DateTime      @default(now()) @db.Timestamp(6)
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// Modelo 5: roles
model Role {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(100)
  permissionsJson Json         @default("[]")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@unique([organizationId, name])
  @@index([organizationId])
}

// Modelo 6: permissões globais
model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  resource  String   @db.VarChar(100)
  action    String   @db.VarChar(100)
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

// Modelo 7: sessões persistentes
model Session {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @db.Uuid
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String?    @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash       String     @unique @db.VarChar(255)
  expiresAt       DateTime   @db.Timestamp(6)
  revokedAt       DateTime?  @db.Timestamp(6)
  createdAt       DateTime   @default(now()) @db.Timestamp(6)
  @@index([userId])
  @@index([tokenHash])
}

// Modelo 8: tokens de reset de senha
model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamp(6)
  usedAt    DateTime? @db.Timestamp(6)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  @@index([userId])
}

// Modelo 9: tokens de verificação de email
model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime @db.Timestamp(6)
  usedAt    DateTime? @db.Timestamp(6)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  @@index([userId])
}

// Modelo 10: subscrições
model Subscription {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String?       @db.Uuid
  plan           Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  status         String        @default("trial") @db.VarChar(50)
  startedAt      DateTime?     @db.Timestamp(6)
  endedAt        DateTime?     @db.Timestamp(6)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

// Modelo 11: uso / métricas
model Usage {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric         String        @db.VarChar(100)
  value          Int           @default(0)
  period         String        @default("monthly") @db.VarChar(20)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@unique([organizationId, metric, period])
  @@index([organizationId])
}

// Modelo 12: eventos de faturamento
model BillingEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  eventType      String        @db.VarChar(100)
  amount         Decimal?      @db.Decimal(10, 2)
  status         String        @default("pending") @db.VarChar(50)
  externalId     String?       @db.VarChar(255)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

// ============================================================
// FASE 3 — CRM
// ============================================================

// FASE 12: waId, externalId added; email made nullable
// FASE 17: campos de importação CSV + consentimento (seções 8/11 da missão
// final — campos aditivos, nulos/descartáveis; CSV nunca altera campos
// protegidos: organizationId, papel/rota de usuário)
model Contact {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String?       @db.VarChar(255)
  name           String        @db.VarChar(255)
  firstName      String?       @db.VarChar(255)
  lastName       String?       @db.VarChar(255)
  company        String?       @db.VarChar(255)
  phone          String?       @db.VarChar(50)
  waId           String?       @db.VarChar(50)
  externalId     String?       @db.VarChar(255)
  source         String?       @db.VarChar(120)
  tags           Json         @default("[]")
  customFields   Json         @default("{}")
  preferences    Json         @default("{}")
  // Consentimento marketing (LGPD): contato importado SEM consentimento
  // comprovado NÃO é elegível para disparos automáticos.
  consentMarketing Boolean    @default(false)
  consentSource  String?      @db.VarChar(200)
  consentAt      DateTime?    @db.Timestamp(6)
  optOut         Boolean      @default(false)
  createdAt      DateTime    @default(now()) @db.Timestamp(6)
  updatedAt      DateTime    @default(now()) @db.Timestamp(6)
  messages       Message[]
  leads          Lead[]
  deals          Deal[]
  campaignRecipients CampaignRecipient[]
  @@index([organizationId])
  @@index([organizationId, waId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model Lead {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?       @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source         String        @default("organic") @db.VarChar(50)
  status         String        @default("new") @db.VarChar(50)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  deals          Deal[]
  @@index([organizationId])
}

model Deal {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?       @db.Uuid
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId      String?       @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String        @db.VarChar(255)
  value          Decimal       @default(0) @db.Decimal(10, 2)
  stage          String        @default("prospecting") @db.VarChar(50)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

model Pipeline {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(100)
  stages         Json          @default("[]")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

// ============================================================
// FASE 4 — Produtos + Mídia
// ============================================================
model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String        @unique @db.VarChar(100)
  name           String        @db.VarChar(255)
  description    String?       @db.Text
  price          Decimal       @default(0) @db.Decimal(10, 2)
  category       String?       @db.VarChar(100)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

model Media {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileKey        String?       @db.VarChar(255)
  url            String?       @db.VarChar(500)
  type           String        @default("image") @db.VarChar(50)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

// ============================================================
// FASE 5 — Publicador + Calendário
// ============================================================
model Post {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String        @db.VarChar(255)
  body           String?       @db.Text
  status         String        @default("draft") @db.VarChar(50)
  publishAt      DateTime?     @db.Timestamp(6)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

model CalendarEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String        @db.VarChar(255)
  eventDate      DateTime      @db.Date
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

// ============================================================
// FASE 6 — Vídeo
// ============================================================
model Video {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String?       @db.VarChar(500)
  duration       Int           @default(0)
  status         String        @default("processing") @db.VarChar(50)
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

// ============================================================
// FASE 8 — Central de Mensagens
// ============================================================
// FASE 12: contactId, externalId, direction, status, updatedAt added
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?       @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  externalId     String?       @db.VarChar(255)
  body           String?       @db.Text
  fromChannel    String        @default("whatsapp") @db.VarChar(50)
  toContact      String?       @db.VarChar(255)
  direction      String        @default("inbound") @db.VarChar(20)
  status         String        @default("received") @db.VarChar(50)
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
  @@index([contactId])
  @@index([externalId])
}

// ============================================================
// FASE 9–11
// ============================================================
model Report {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportType     String        @db.VarChar(100)
  data           Json          @default("{}")
  createdAt      DateTime      @default(now()) @db.Timestamp(6)
  @@index([organizationId])
}

// ============================================================
// FASE META — Meta Integration (managed via Supabase RLS)
// Tabela: meta_integrations
// ============================================================
model MetaIntegration {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessToken    String    @db.Text
  refreshToken   String?   @db.Text
  expiresIn      Int?
  pageAccessToken String?  @db.Text
  phoneNumberId  String?   @db.VarChar(50)
  accountId      String?   @db.VarChar(50)
  status         String    @default("connected") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt
  webhookEvents  WebhookEvent[]
  @@map("meta_integrations")
}

// Tabela: webhook_events
model WebhookEvent {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String?       @db.Uuid
  metaEventId      String?       @db.VarChar(255)
  integrationId    String?       @db.Uuid
  eventType        String?       @db.VarChar(50)
  payloadHash      String?       @db.VarChar(64)
  processedAt      DateTime?
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  metaIntegration  MetaIntegration? @relation(fields: [integrationId], references: [id])
  @@map("webhook_events")
}

// ============================================================
// FASE AGENT — Centro Administrativo Inteligente (Phase 2)
// Fila persistente de tarefas + memória de projeto/tenant.
//
// Task      — uma tarefa de agente (IA ou agente local), com estado
//             e progresso real (0–100) recalculado a cada etapa.
// TaskStep  — etapas ordenadas; o progresso deriva do estado real
//             dos passos (jamais estimado).
// TaskEvent — log append-only (mudanças de estado, mensagens,
//             uso de tokens, esperas de humano).
// AgentMemory — memória persistente do tenant/usuário
//             (decisões, lições, preferências) consumida pelo chat.
//
// Estados da Task (máquina de estados):
//   queued → running → waiting_human → running → completed
//                                   ↘ failed / canceled
// ============================================================

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String       @db.VarChar(300)
  status         String       @default("queued") @db.VarChar(30)
  progress       Int          @default(0)
  inputJson      Json         @default("{}")
  resultJson     Json?
  errorText      String?      @db.Text
  modelUsed      String?      @db.VarChar(100)
  usageJson      Json?
  waitingReason  String?      @db.VarChar(300)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?    @db.Timestamp(6)
  steps          TaskStep[]
  events         TaskEvent[]
  @@index([organizationId, status])
  @@index([userId])
}

model TaskStep {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String    @db.Uuid
  organizationId String    @db.Uuid
  seq            Int
  name           String    @db.VarChar(200)
  status         String    @default("pending") @db.VarChar(30)
  detailJson     Json?
  startedAt      DateTime? @db.Timestamp(6)
  finishedAt     DateTime? @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @db.Timestamp(6)
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, seq])
  @@index([organizationId])
}

model TaskEvent {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @db.Uuid
  organizationId String   @db.Uuid
  type           String   @db.VarChar(60)
  payloadJson    Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamp(6)
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
  @@index([organizationId])
}

model AgentMemory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String       @db.VarChar(40)
  memoryKey      String       @db.VarChar(200)
  valueJson      Json
  supersededAt   DateTime?    @db.Timestamp(6)
  createdAt      DateTime     @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @updatedAt
  @@unique([organizationId, userId, kind, memoryKey])
  @@index([organizationId, userId])
}

// ============================================================
// FASE 17 — CAMPANHAS E DISPARIOS (missão final, seções 9–12)
//
// Campanha = mensagem + público + canal + conta selecionada.
// Estados (máquina): draft → pending_validation → scheduled →
//   queued → running → paused → completed / completed_partial /
//   failed / canceled;  waiting_manual (modo sem API, §12).
// Resultado POR DESTINATÁRIO em CampaignRecipient (idempotência:
// unique (campaignId, contactId)); progresso real, sem métrica fictícia.
// ============================================================

model Campaign {
  id           String     @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String     @db.Uuid
  title        String     @db.VarChar(300)
  channel      String     @db.VarChar(30)
  status       String     @default("draft") @db.VarChar(30)
  /// Conta multicontas SELECIONADA (id da meta_integrations / config do
  /// provedor). Ausente em canais manuais. NUNCA há conta "padrão global":
  /// cada operação valida a conta e o tenant.
  accountId    String?    @db.VarChar(64)
  message      String     @db.Text
  variables    Json      @default("{}")
  audienceJson Json      @default("{}")
  batchJson    Json      @default("{}")
  /// 'auto' (enviado pela plataforma) | 'manual' (usuário confirmou o
  /// disparo fora da plataforma — §12; a RX NUNCA afirma ter enviado).
  resultKind   String?    @db.VarChar(20)
  scheduledFor DateTime?  @db.Timestamp(6)
  startedAt    DateTime?  @db.Timestamp(6)
  completedAt  DateTime?  @db.Timestamp(6)
  progress     Int        @default(0)
  totalCount   Int        @default(0)
  sentCount    Int        @default(0)
  failedCount  Int        @default(0)
  skippedCount Int        @default(0)
  errorText    String?
  manualNotes  String?
  createdAt    DateTime  @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @db.Timestamp(6)
  recipients   CampaignRecipient[]
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model CampaignRecipient {
  id        String     @id @default(uuid()) @db.Uuid
  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String    @db.Uuid
  organizationId String @db.Uuid
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String     @db.Uuid
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  externalMessageId String? @db.VarChar(200)
  lastError  String?
  sentAt     DateTime? @db.Timestamp(6)
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime  @default(now()) @db.Timestamp(6)
  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([organizationId])
}
