generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// REVOLUTION X — Prisma Schema (fusão Fonte C + Workspace + Supabase)
//
// Este schema contém:
// - FASE 2: Auth + Multi-tenant
// - FASE 3: CRM (Contact, Lead, Deal, Pipeline)
// - FASE 4: Produtos + Mídia
// - FASE 5: Publicador + Calendário
// - FASE 6: Vídeo
// - FASE 8: Central de Mensagens
// - FASE 9–11: (placeholders)
// - FASE 12: Meta/WhatsApp (waId, externalId, direction)
// - FASE META: MetaIntegration + WebhookEvent (tabela snake_case via @@map)
// ============================================================

// Modelo 1: plano
model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(100)
  priceMonthly Decimal  @map("price_monthly") @default(0) @db.Decimal(10, 2)
  limitsJson   Json     @map("limits_json") @default("{}")
  featuresJson Json     @map("features_json") @default("{}")
  createdAt    DateTime @map("created_at") @default(now()) @db.Timestamp(6)
  organizations Organization[]
  subscriptions Subscription[]
  @@map("plans")
}

// Modelo 2: usuário
model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique @db.VarChar(255)
  name             String    @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  emailVerified    Boolean   @map("email_verified") @default(false)
  createdAt        DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt        DateTime  @map("updated_at") @updatedAt
  organizationMembers OrganizationMember[]
  sessions         Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  // FASE AGENT (Phase 2 — Centro Administrativo com IA)
  tasks        Task[]
  agentMemories AgentMemory[]
  adminAlerts AdminAlert[]
  @@map("users")
}

// Modelo 3: organização (tenant)
model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(255)
  slug         String    @unique @db.VarChar(255)
  status       String    @default("active") @db.VarChar(50)
  planId       String?   @map("plan_id") @db.Uuid
  plan         Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @map("updated_at") @updatedAt
  members      OrganizationMember[]
  contacts     Contact[]
  leads        Lead[]
  deals        Deal[]
  pipelines    Pipeline[]
  products     Product[]
  media        Media[]
  posts        Post[]
  calendarEvents CalendarEvent[]
  videos       Video[]
  messages     Message[]
  reports      Report[]
  subscriptions Subscription[]
  usages       Usage[]
  billingEvents BillingEvent[]
  sessions     Session[]
  roles        Role[]
  metaIntegrations MetaIntegration[]
  tasks        Task[]
  agentMemories AgentMemory[]
  adminAlerts  AdminAlert[]
  campaigns    Campaign[]
  riskLogs     RiskLog[]
  scraperConfigs ScraperConfig[]
  whatsappChannels WhatsappChannel[]
  whatsappTemplates WhatsappTemplate[]
  integrationEvents IntegrationEvent[]
  schedules        Schedule[]
  growthLeads      GrowthLead[]
  whatsappInstances WhatsappInstance[]
  messageStatuses   MessageStatus[]
  webhookDeadLetters WebhookDeadLetter[]
  webhookEvents     WebhookEvent[]
  @@map("organizations")
}

// Modelo 4: membro da organização (relação user-org com papel)
model OrganizationMember {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String        @default("member") @db.VarChar(50)
  joinedAt       DateTime      @map("joined_at") @default(now()) @db.Timestamp(6)
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// Modelo 5: papel (para RBAC)
model Role {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(100)
  description    String?       @db.Text
  permissions    Permission[]
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// Modelo 6: permissão (granular)
model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  roles       Role[]
  @@map("permissions")
}

// Modelo 7: sessão de usuário (para JWT refresh rotation)
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?   @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String    @map("token_hash") @db.Text
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  @@index([userId])
  @@index([organizationId])
  @@map("sessions")
}

// Modelo 8: token de reset de senha
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  @@index([userId])
  @@map("password_reset_tokens")
}

// Modelo 9: token de verificação de e-mail
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  @@index([userId])
  @@map("email_verification_tokens")
}

// Modelo 10: assinatura (billing)
model Subscription {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String        @map("plan_id") @db.Uuid
  plan           Plan          @relation(fields: [planId], references: [id])
  status         String        @default("active") @db.VarChar(50)
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(6)
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  @@index([organizationId])
  @@index([status])
  @@map("subscriptions")
}

// Modelo 11: uso/limites (rate limiting por tenant)
model Usage {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric         String        @db.VarChar(100)
  period         String        @db.VarChar(50)
  value          Int           @default(0)
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  @@unique([organizationId, metric, period])
  @@index([organizationId])
  @@map("usage")
}

// Modelo 12: eventos de billing (webhook Stripe etc.)
model BillingEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  type           String        @db.VarChar(100)
  payload        Json          @default("{}")
  processed      Boolean       @default(false)
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("billing_events")
}

// ============================================================
// FASE 3 — CRM (Contact, Lead, Deal, Pipeline)
// ============================================================
// Modelo 13: contato (protegidos: organizationId, papel/rota de usuário)
model Contact {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String?       @db.VarChar(255)
  name           String        @db.VarChar(255)
  firstName      String?       @map("first_name") @db.VarChar(255)
  lastName       String?       @map("last_name") @db.VarChar(255)
  company        String?       @db.VarChar(255)
  phone          String?       @db.VarChar(50)
  waId           String?       @map("wa_id") @db.VarChar(50)
  externalId     String?       @map("external_id") @db.VarChar(255)
  source         String?       @db.VarChar(120)
  tags           Json          @map("tags") @default("[]")
  customFields   Json          @map("custom_fields") @default("{}")
  preferences    Json          @map("preferences") @default("{}")
  // Consentimento marketing (LGPD): contato importado SEM consentimento
  // comprovado NÃO é elegível para disparos automáticos.
  consentMarketing Boolean     @map("consent_marketing") @default(false)
  consentSource  String?       @map("consent_source") @db.VarChar(200)
  consentAt      DateTime?     @map("consent_at") @db.Timestamp(6)
  optOut         Boolean       @map("opt_out") @default(false)
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt @db.Timestamp(6)
  messages       Message[]
  leads          Lead[]
  deals          Deal[]
  campaignRecipients CampaignRecipient[]
  @@index([organizationId])
  @@index([organizationId, waId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@unique([organizationId, waId])
  @@map("contacts")
}

// Modelo 14: lead
model Lead {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?       @map("contact_id") @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source         String        @default("organic") @db.VarChar(50)
  status         String        @default("new") @db.VarChar(50)
  metadata       Json          @default("{}")
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  deals          Deal[]        @relation("DealLead")
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([contactId])
  @@map("leads")
}

// Modelo 15: deal
model Deal {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?       @map("contact_id") @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipelineId     String?       @map("pipeline_id") @db.Uuid
  pipeline       Pipeline?     @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  title          String        @db.VarChar(300)
  value          Decimal       @default(0) @db.Decimal(10, 2)
  stage          String        @default("prospecting") @db.VarChar(50)
  metadata       Json          @default("{}")
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  lead           Lead?         @relation("DealLead", fields: [leadId], references: [id])
  leadId         String?       @map("lead_id") @db.Uuid
  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([pipelineId])
  @@index([contactId])
  @@map("deals")
}

// Modelo 16: pipeline
model Pipeline {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(255)
  stages         String[]      @default(["prospecting", "proposal", "negotiation", "won", "lost"])
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  deals          Deal[]
  @@index([organizationId])
  @@map("pipelines")
}

// Modelo 17: produto
model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String        @db.VarChar(255)
  description    String?       @db.Text
  price          Decimal?      @db.Decimal(10, 2)
  category       String?       @db.VarChar(100)
  active         Boolean       @default(true)
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  @@index([organizationId])
  @@map("products")
}

// Modelo 18: mídia
model Media {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String?       @db.VarChar(500)
  type           String        @db.VarChar(50)
  metadata       Json          @default("{}")
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  @@index([organizationId])
  @@map("media")
}

// Modelo 19: post (publicador)
model Post {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  content        String        @db.Text
  platform       String        @db.VarChar(50)
  status         String        @default("draft") @db.VarChar(50)
  scheduledAt    DateTime?     @map("scheduled_at") @db.Timestamptz(6)
  publishedAt    DateTime?     @map("published_at") @db.Timestamptz(6)
  metadata       Json          @default("{}")
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("posts")
}

// Modelo 20: evento de calendário
model CalendarEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String        @db.VarChar(255)
  description    String?       @db.Text
  startAt        DateTime      @map("start_at") @db.Timestamptz(6)
  endAt          DateTime      @map("end_at") @db.Timestamptz(6)
  allDay         Boolean       @map("all_day") @default(false)
  metadata       Json          @default("{}")
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  @@index([organizationId])
  @@index([organizationId, startAt])
  @@map("calendar_events")
}

// Modelo 21: vídeo
model Video {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String?       @db.VarChar(500)
  duration       Int           @default(0)
  status         String        @default("processing") @db.VarChar(50)
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  @@index([organizationId])
  @@map("videos")
}

// Modelo 21b: agendamento (FASE 5)
model Schedule {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String        @db.Text
  description    String?       @db.Text
  scheduledAt    DateTime      @map("scheduled_at") @db.Timestamptz(6)
  status         String        @default("draft") @db.VarChar(50)
  channel        String?       @db.VarChar(50)
  content        String?       @db.Text
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt
  @@index([organizationId])
  @@map("schedules")
}

// Modelo: Growth Lead (FASE Growth - WhatsApp/Instagram leads)
model GrowthLead {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organizationId") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         String    @default("instagram") @db.VarChar(50)
  contact        String    @db.VarChar(50)
  metadata       Json      @default("{}")
  status         String    @default("pending") @db.VarChar(50)
  funnelStatus   String    @map("funnel_status") @default("pending") @db.VarChar(50)
  lastContactAt  DateTime? @map("last_contact_at") @db.Timestamptz(6)
  responseCount  Int       @map("response_count") @default(0)
  costPerLead    Decimal?  @map("cost_per_lead") @db.Decimal(10, 2)
  notes          String?   @db.Text
  assignedTo     String?   @map("assigned_to") @db.Uuid
  createdAt      DateTime  @map("createdAt") @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @map("updatedAt") @updatedAt @db.Timestamptz(6)
  @@unique([organizationId, contact])
  @@index([organizationId, funnelStatus])
  @@index([organizationId, assignedTo])
  @@index([organizationId, lastContactAt])
  @@map("growth_leads")
}

// Modelo: WhatsApp Instance (FASE Growth - Evolution API)
model WhatsappInstance {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organizationId") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instanceName   String    @map("instanceName") @db.Text
  status         String    @default("DISCONNECTED") @db.VarChar(50)
  qrCode         String?   @map("qrCode") @db.Text
  accessToken    String?   @map("accessToken") @db.Text
  lastHeartbeat  DateTime? @map("lastHeartbeat") @db.Timestamptz(6)
  createdAt      DateTime  @map("createdAt") @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @map("updatedAt") @updatedAt @db.Timestamptz(6)
  @@unique([organizationId, instanceName])
  @@index([organizationId, status])
  @@map("whatsapp_instances")
}

// Modelo 22: mensagem (Central de Mensagens)
model Message {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?       @map("contact_id") @db.Uuid
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  externalId     String?       @map("external_id") @db.VarChar(255)
  body           String?       @db.Text
  fromChannel    String        @map("from_channel") @default("whatsapp") @db.VarChar(50)
  toContact      String?       @map("to_contact") @db.VarChar(255)
  direction      String        @default("inbound") @db.VarChar(20)
  status         String        @default("received") @db.VarChar(50)
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @map("updated_at") @updatedAt @db.Timestamptz(6)
  @@index([organizationId])
  @@index([contactId])
  @@index([externalId])
  @@map("messages")
}

// Modelo 23: relatório
model Report {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportType     String        @map("report_type") @db.VarChar(100)
  data           Json          @default("{}")
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamp(6)
  @@index([organizationId])
  @@map("reports")
}

// ============================================================
// FASE META — Meta Integration (managed via Supabase RLS)
// Tabela: meta_integrations
// ============================================================
// Tabela: meta_integrations (canônica snake_case = PRODUÇÃO, migration 025).
// Shape legado camelCase (accessToken/expiresIn/pageAccessToken/...) FOI removido:
// produção e local agora compartilham 16 colunas snake_case idênticas.
model MetaIntegration {
  id                        String    @id @default(uuid()) @map("id") @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  organization              Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider                  String    @map("provider") @db.Text
  metaPageId                String?   @map("meta_page_id") @db.Text
  instagramAccountId        String?   @map("instagram_account_id") @db.Text
  whatsappBusinessAccountId String?   @map("whatsapp_business_account_id") @db.Text
  phoneNumberId             String?   @map("phone_number_id") @db.Text
  metaAppId                 String?   @map("meta_app_id") @db.Text
  encryptedAccessToken      String    @map("encrypted_access_token") @db.Text
  tokenExpiresAt            DateTime? @map("token_expires_at") @db.Timestamptz(6)
  connectedAt               DateTime  @default(now()) @map("connected_at") @db.Timestamptz(6)
  disconnectedAt            DateTime? @map("disconnected_at") @db.Timestamptz(6)
  status                    String    @default("PENDING") @map("status") @db.Text
  lastError                 String?   @map("last_error") @db.Text
  webhookSecret             String?   @map("webhook_secret") @db.Text
  displayName               String?   @map("display_name") @db.Text
  webhookEvents             WebhookEvent[]
  @@map("meta_integrations")
}

// Tabela: webhook_events (canônica snake_case + openbsp_event_id, migration 025)
model WebhookEvent {
  eventId        String            @id @default(uuid()) @map("event_id") @db.Uuid
  metaEventId    String            @map("meta_event_id") @db.Text
  integrationId  String?           @map("integration_id") @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  eventType      String            @map("event_type") @db.Text
  payloadHash    String            @map("payload_hash") @db.Text
  processedAt    DateTime          @default(now()) @map("processed_at") @db.Timestamptz(6)
  openbspEventId String?           @map("openbsp_event_id") @db.Text
  metaIntegration MetaIntegration? @relation(fields: [integrationId], references: [id])
  @@unique([metaEventId, integrationId])
  @@index([organizationId])
  @@map("webhook_events")
}

// ============================================================
// FASE AGENT — Centro Administrativo Inteligente (Phase 2)
// Fila persistente de tarefas + memória de projeto/tenant.
//
// Task      — uma tarefa de agente (IA ou agente local), com estado
//             e progresso real (0–100) recalculado a cada etapa.
// TaskStep  — etapas ordenadas; o progresso deriva do estado real
//             dos passos (jamais estimado).
// TaskEvent — log append-only (mudanças de estado, mensagens,
//             uso de tokens, esperas de humano).
// AgentMemory — memória persistente do tenant/usuário
//             (decisões, lições, preferências) consumida pelo chat.
//
// Estados da Task (máquina de estados):
//   queued → running → waiting_human → running → completed
//                                   ↘ failed / canceled
// ============================================================

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String       @db.VarChar(300)
  status         String       @default("queued") @db.VarChar(30)
  progress       Int          @default(0)
  inputJson      Json         @default("{}")
  resultJson     Json?
  errorText      String?      @db.Text
  modelUsed      String?      @map("model_used") @db.VarChar(100)
  usageJson      Json?
  waitingReason  String?      @map("waiting_reason") @db.VarChar(300)
  createdAt      DateTime     @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @map("updated_at") @updatedAt
  completedAt    DateTime?    @map("completed_at") @db.Timestamp(6)
  steps          TaskStep[]
  events         TaskEvent[]
  @@index([organizationId, status])
  @@index([userId])
  @@map("tasks")
}

model TaskStep {
  id             String    @id @default(uuid()) @db.Uuid
  taskId         String    @map("task_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  seq            Int
  name           String    @db.VarChar(200)
  status         String    @default("pending") @db.VarChar(30)
  detailJson     Json?
  startedAt      DateTime? @map("started_at") @db.Timestamp(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamp(6)
  createdAt      DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, seq])
  @@index([organizationId])
  @@map("task_steps")
}

model TaskEvent {
  id             String   @id @default(uuid()) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String   @db.VarChar(60)
  payloadJson    Json     @default("{}")
  createdAt      DateTime @map("created_at") @default(now()) @db.Timestamp(6)
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
  @@index([organizationId])
  @@map("task_events")
}

model AgentMemory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String       @db.VarChar(40)
  memoryKey      String       @map("memory_key") @db.VarChar(200)
  valueJson      Json
  supersededAt   DateTime?    @map("superseded_at") @db.Timestamp(6)
  createdAt      DateTime     @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt      DateTime     @map("updated_at") @updatedAt
  @@unique([organizationId, userId, kind, memoryKey])
  @@index([organizationId, userId])
  @@map("agent_memories")
}

model AdminAlert {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?       @map("user_id") @db.Uuid
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  type           String        @db.VarChar(50)
  severity       String        @db.VarChar(20) @default("warning")
  title          String        @db.VarChar(255)
  message        String        @db.Text
  statusCode     Int?
  route          String?       @db.VarChar(255)
  timestamp      DateTime      @default(now()) @db.Timestamp(6)
  metadata       Json          @default("{}")
  @@index([organizationId])
  @@index([timestamp])
  @@map("admin_alerts")
}

// ============================================================
// FASE 17 — CAMPANHAS E DISPAROS (missão final, seções 9–12)
//
// Campanha = mensagem + público + canal + conta selecionada.
// Estados (máquina, cf. CAMPAIGN_STATUSES no serviço): draft,
//   awaiting_validation, scheduled, queued, running, paused,
//   completed, completed_partial, failed, canceled.
// Modo sem API (§12): canal 'manual' + resultKind 'manual'; a
//   plataforma NUNCA afirma ter enviado (completed só por
//   confirmação manual do usuário).
// Resultado POR DESTINATÁRIO em CampaignRecipient (idempotência:
// unique (campaignId, contactId)); progresso real, sem métrica fictícia.
// ============================================================

model Campaign {
  id           String     @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId       String     @map("user_id") @db.Uuid
  title        String     @db.VarChar(300)
  channel      String     @db.VarChar(30)
  status       String     @default("draft") @db.VarChar(30)
  /// Conta multicontas SELECIONADA (id da meta_integrations / config do
  /// provedor). Ausente em canais manuais. NUNCA há conta "padrão global":
  /// cada operação valida a conta e o tenant.
  accountId    String?    @map("account_id") @db.VarChar(64)
  message      String     @db.Text
  variables    Json      @default("{}")
  audienceJson Json      @map("audience_json") @default("{}")
  batchJson    Json      @map("batch_json") @default("{}")
  /// 'auto' (enviado pela plataforma) | 'manual' (usuário confirmou o
  /// disparo fora da plataforma — §12; a RX NUNCA afirma ter enviado).
  resultKind   String?    @map("result_kind") @db.VarChar(20)
  scheduledFor DateTime?  @map("scheduled_for") @db.Timestamp(6)
  startedAt    DateTime?  @map("started_at") @db.Timestamp(6)
  completedAt  DateTime?  @map("completed_at") @db.Timestamp(6)
  progress     Int        @default(0)
  totalCount   Int        @map("total_count") @default(0)
  sentCount    Int        @map("sent_count") @default(0)
  failedCount  Int        @map("failed_count") @default(0)
  skippedCount Int        @map("skipped_count") @default(0)
  errorText    String?    @map("error_text")
  manualNotes  String?    @map("manual_notes")
  createdAt    DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt    DateTime  @map("updated_at") @default(now()) @db.Timestamp(6)
  recipients   CampaignRecipient[]
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id        String     @id @default(uuid()) @db.Uuid
  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String    @map("campaign_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String     @map("contact_id") @db.Uuid
  status     String    @default("pending") @db.VarChar(20)
  attempts   Int       @default(0)
  externalMessageId String? @map("external_message_id") @db.VarChar(200)
  lastError  String?    @map("last_error")
  sentAt     DateTime? @map("sent_at") @db.Timestamp(6)
  createdAt  DateTime  @map("created_at") @default(now()) @db.Timestamp(6)
  updatedAt  DateTime  @map("updated_at") @default(now()) @db.Timestamp(6)
  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([organizationId])
  @@map("campaign_recipients")
}

// ============================================================
// MÓDULO DE SCRAPERS DE RISCO (migration 020)
// Registra todas as ações de scraping para auditoria e compliance.
