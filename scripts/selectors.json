{
  "pages_show_list": [
    { "action": "goto", "selector": "/connections" },
    { "action": "click", "selector": "[aria-label*='Connect Facebook']" },
    { "action": "click", "selector": "[aria-label*='Connect']" },
    { "action": "click", "selector": "button:has-text(\"Connect\")" }
  ],
  "instagram_basic": [
    { "action": "goto", "selector": "/edit/permissions" },
    { "action": "click", "selector": "[aria-label*='Connect Instagram']" },
    { "action": "click", "selector": "button:has-text(\"Save\")" }
  ],
  "instagram_content_publish": [
    { "action": "goto", "selector": "/content/publish" },
    { "action": "click", "selector": "[aria-label*='Toggle Publish']" },
    { "action": "click", "selector": "button:has-text(\"Done\")" }
