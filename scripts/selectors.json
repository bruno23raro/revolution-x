    { "action": "goto", "selector": "/insights/engagement" },
    { "action": "click", "selector": "[aria-label*='Toggle Engagement']" },
    { "action": "click", "selector": "button:has-text(\"Apply\")" }
  ],
  "pages_manage_ads": [
    { "action": "goto", "selector": "/ads/management" },
